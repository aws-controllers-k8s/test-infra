          ],
          "env": [
            {
              "name": "AUTOPILOT_ORG",
              "value": "aws-controllers-k8s"
            },
            {
              "name": "AUTOPILOT_SDK_BUMP_WRITE",
              "value": "true"
            },
            {
              "name": "GITHUB_ACTOR",
              "value": "ack-bot"
            },
            {
              "name": "GITHUB_EMAIL_ID",
              "value": "82905295"
            },
            {
              "name": "GITHUB_TOKEN",
              "valueFrom": {
                "secretKeyRef": {
                  "key": "token",
                  "name": "prowjob-github-pat-token"
                }
              }
            },
            {
              "name": "ISSUE_AUTHOR",
              "value": "ack-autopilot"
            },
            {
              "name": "ISSUE_NUMBER",
              "value": "0"
            },
            {
              "name": "REPO_NAME",
              "value": "s3-controller"
            },
            {
              "name": "REPO_OWNER",
              "value": "aws-controllers-k8s"
            },
            {
              "name": "SDK_TO",
              "value": "service/s3/v1.97.3"
            },
            {
              "name": "SERVICE",
              "value": "s3"
            },
            {
              "name": "TEST_INFRA_ORG",
              "value": "aws-controllers-k8s"
            },
            {
              "name": "WORKFLOW_NAME",
              "value": "sdk-bump"
            },
            {
              "name": "WORK_ITEM",
              "value": "sha256:0123456789abcdef"
            }
          ],
          "image": "registry.example/prow:prow-auto-generate-controllers-0.0.48",
          "name": "workflow-runner",
          "resources": {
            "limits": {
              "cpu": "8",
              "memory": "8Gi"
            },
            "requests": {
              "cpu": "8",
              "memory": "8Gi"
            }
          },
          "volumeMounts": [
            {
              "mountPath": "/etc/github",
              "name": "github-token",
              "readOnly": true
            }
          ]
        }
      ],
      "restartPolicy": "Never",
      "serviceAccountName": "periodic-service-account",
      "volumes": [
        {
          "csi": {
            "driver": "secrets-store.csi.k8s.io",
            "readOnly": true,
            "volumeAttributes": {
              "secretProviderClass": "prow-secrets"
            }
          },
          "name": "github-token"
        }
      ]
