      "prow.k8s.io/job": "autopilot-sdk-bump",
      "prow.k8s.io/refs.org": "aws-controllers-k8s",
      "prow.k8s.io/refs.pull": "0",
      "prow.k8s.io/refs.repo": "s3-controller",
      "workflow-agent/command-args": "change-class=SDK-bump,sdk-to=service/s3/v1.97.3,service=s3,work-item=sha256:0123456789abcdef",
      "workflow-agent/issue-number": "0",
      "workflow-agent/workflow-name": "sdk-bump"
    },
    "labels": {
      "app.kubernetes.io/name": "autopilot-sdk-bump",
      "created-by-prow": "true",
      "prow.k8s.io/job": "autopilot-sdk-bump",
      "prow.k8s.io/refs.org": "aws-controllers-k8s",
      "prow.k8s.io/refs.repo": "s3-controller",
      "prow.k8s.io/type": "periodic",
      "triggered-by": "workflow-agent",
      "workflow-agent/issue-number": "0",
      "workflow-type": "sdk-bump"
