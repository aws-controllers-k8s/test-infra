FROM public.ecr.aws/docker/library/alpine:3.17.2

WORKDIR /docs
COPY build-docs.sh /docs/build-docs.sh

# NOTE: alpine 3.17 is end-of-life and no longer receives security updates, so
# this upgrade is a no-op for most advisories. Bumping the base tag is tracked
# separately -- it needs the docs build revalidated against a newer Python.
RUN apk -U upgrade --no-cache

RUN apk add -y --no-cache \
    bash \
    gcc \
    libc-dev \
    libc6-compat \
    git \
    openssl-dev \
    libffi-dev \
    make && chmod +x /docs/build-docs.sh

RUN apk add -y --no-cache python3 python3-dev py3-pip && ln -sf python3 /usr/bin/python
RUN apk add -y --no-cache --update npm

ENTRYPOINT ["./build-docs.sh"]